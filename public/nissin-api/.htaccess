RewriteEngine On
RewriteBase /

# ==========================================
# 1. ATURAN UNTUK BACKEND (NISSIN-API)
# ==========================================
# Pastikan aturan ini hanya berjalan jika ada request nyata ke jalur /nissin-api
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Aturan Detail Objek via Path
RewriteRule ^nissin-api/carousels/([0-9]+)$ nissin-api/api.php?action=carousels&id=$1 [QSA,L]
RewriteRule ^nissin-api/categories/([0-9]+)$ nissin-api/api.php?action=categories&id=$1 [QSA,L]
RewriteRule ^nissin-api/products/([0-9]+)$ nissin-api/api.php?action=products&id=$1 [QSA,L]
RewriteRule ^nissin-api/products/latest$ nissin-api/api.php?action=products&latest=true [QSA,L]

# Aturan Koleksi Umum
RewriteRule ^nissin-api/carousels$ nissin-api/api.php?action=carousels [QSA,L]
RewriteRule ^nissin-api/categories$ nissin-api/api.php?action=categories [QSA,L]
RewriteRule ^nissin-api/products$ nissin-api/api.php?action=products [QSA,L]
RewriteRule ^nissin-api/generate-file$ nissin-api/api.php?action=generate-file [QSA,L]

# ==========================================
# 2. ATURAN UNTUK FRONTEND ANGULAR (SPA)
# ==========================================
# Jika URL yang diakses bukan file asli, bukan folder asli, DAN bukan jalur API,
# maka lempar request tersebut ke index.html agar dibaca oleh Router Angular.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/nissin-api [NC]
RewriteRule ^(.*)$ index.html [QSA,L]
